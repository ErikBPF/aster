# Builds both binaries the deployment needs: the HTTP server and the metadata
# controller. Build context is the repository root.
FROM docker.io/library/rust:1.89-bookworm AS build
# The RPC surface is code-generated from proto/aster.proto, so protoc and the
# vendored proto tree have to be in the image; libprotobuf-dev supplies the
# well-known google/protobuf/*.proto includes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY proto ./proto
COPY crates ./crates
COPY migrations ./migrations
RUN cargo build --release --locked -p aster-server -p aster-controller

FROM docker.io/library/debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --create-home app \
    && install -d -o 65532 -g 65532 /data/notebooks
COPY --from=build /app/target/release/aster-server /usr/local/bin/aster-server
COPY --from=build /app/target/release/aster-controller /usr/local/bin/aster-controller
# Shipped so ASTER_CONTRACTS_DIR=/etc/aster/contracts resolves with no mount; a
# deployment can still override the directory with a volume.
COPY contracts /etc/aster/contracts
USER 65532:65532
EXPOSE 8080
ENV ASTER_BIND=0.0.0.0:8080
ENTRYPOINT ["/usr/local/bin/aster-server"]
