{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "aster chart values",
  "type": "object",
  "required": ["image", "engines", "catalogs"],
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Any image repository, local or remote. No registry is assumed."
        },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "description": "Optional immutable image digest; empty renders the tag alone.",
          "anyOf": [
            { "const": "" },
            { "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["port", "name", "user"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "sslMode": { "type": "string" }
      }
    },
    "engines": {
      "type": "array",
      "description": "Query engine pool. The first entry is the default.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "endpoint"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "kind": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "pattern": "^https?://" },
          "routingGroup": { "type": "string" }
        }
      }
    },
    "catalogs": {
      "type": "array",
      "description": "Metadata catalog pool. The first entry is the default.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "endpoint"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "kind": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "pattern": "^https?://" },
          "catalog": { "type": "string" }
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "catalogBindings": { "type": "string" },
        "contractsDir": { "type": "string" },
        "notebookDir": { "type": "string" },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "otlpEndpoint": { "type": "string" },
        "sharedModels": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedOrigins": { "type": "string" },
            "activeKey": { "type": "string" },
            "keysetSecretName": { "type": "string" },
            "authorityEnabled": { "type": "boolean" },
            "useEnabled": { "type": "boolean" },
            "authentikApiOrigin": { "type": "string" },
            "adminGroupUuid": { "type": "string" },
            "editorGroupUuid": { "type": "string" },
            "readTokenSecretName": { "type": "string" }
          }
        },
        "identity": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["oidc", "none"] },
            "issuer": { "type": "string" },
            "clientId": { "type": "string" },
            "scopes": { "type": "string" },
            "groupsClaim": { "type": "string" },
            "redirectUri": { "type": "string" },
            "adminGroup": { "type": "string" },
            "editorGroup": { "type": "string" },
            "userUuidClaim": { "type": "string" }
          }
        },
        "sessionTtlSeconds": { "type": "integer", "minimum": 60 },
        "handshakeTtlSeconds": { "type": "integer", "minimum": 30 },
        "userStateTtlSeconds": { "type": "integer", "minimum": 60 }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "reconcileSeconds": { "type": "integer", "minimum": 1 },
        "auditRetentionDays": { "type": "integer", "minimum": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClassName": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Existing Secret to read database_url, state_url, oidc_client_secret and default from. Empty generates one."
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaces": { "type": "array", "items": { "type": "string" } },
        "metricsNamespaces": { "type": "array", "items": { "type": "string" } },
        "egressPorts": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
