{
  "realm": "aster",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    { "name": "aster-admins" },
    { "name": "aster-editors" }
  ],
  "users": [
    {
      "username": "root",
      "enabled": true,
      "emailVerified": true,
      "email": "root@example.invalid",
      "firstName": "Root",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "aster-dev-root", "temporary": false }
      ],
      "groups": ["/aster-admins"]
    },
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.invalid",
      "firstName": "Alice",
      "lastName": "Editor",
      "credentials": [
        { "type": "password", "value": "aster-dev-alice", "temporary": false }
      ],
      "groups": ["/aster-editors"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.invalid",
      "firstName": "Bob",
      "lastName": "Viewer",
      "credentials": [
        { "type": "password", "value": "aster-dev-bob", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "aster",
      "name": "aster",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "aster-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/callback",
        "http://127.0.0.1:8080/callback",
        "http://localhost:18080/callback"
      ],
      "webOrigins": ["http://localhost:8080"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
